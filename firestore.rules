rules_version = '2';

// Reglas simples y suficientes para este evento puntual:
// cualquiera puede LEER el estado (necesario para la pantalla pública
// y el celular de los participantes), y cualquiera con el enlace
// también puede escribir (el panel de admin está protegido por
// contraseña dentro de la propia app, no por estas reglas).
//
// Esto es intencionalmente simple porque es un evento de pocas horas.
// Ver README, sección "Seguridad", para más contexto y para una
// versión más restrictiva si quisieran usarla en otro evento.
service cloud.firestore {
  match /databases/{database}/documents {
    match /live/estado {
      allow read: if true;
      allow write: if true;
    }
  }
}
