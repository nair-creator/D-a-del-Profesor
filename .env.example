# Copiá este archivo a ".env" y completá con los datos de TU proyecto de Firebase
# (Configuración del proyecto -> Tus apps -> Config del SDK). Ver README, paso "Configurar Firebase".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Contraseña para entrar al panel de administración (/admin)
VITE_ADMIN_PASSWORD=amanecer2026
